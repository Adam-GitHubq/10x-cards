---
import "../styles/global.css";
import ThemeToggle from "../components/ui/ThemeToggle";
import UserMenu from "../components/ui/UserMenu";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;
const { user } = Astro.locals;

const themeScript = `(()=>{if(typeof window==="undefined"||typeof document==="undefined")return;const STORAGE_KEY="10x-cards-theme";const stored=localStorage.getItem(STORAGE_KEY);const prefersDark=window.matchMedia("(prefers-color-scheme: dark)").matches;const next=stored==="light"||stored==="dark"?stored:prefersDark?"dark":"light";document.documentElement.dataset.theme=next;document.documentElement.classList.toggle("dark",next==="dark")})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline set:html={themeScript} />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <header class="border-b border-border/40 bg-background/70 px-4 py-3 backdrop-blur-sm sm:px-8">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 text-lg font-semibold text-foreground">
          <span
            class="flex size-10 items-center justify-center rounded-xl bg-primary/15 text-2xl font-bold text-primary shadow-xs"
          >
            10x
          </span>
          <span class="tracking-tight">10xCards</span>
        </a>
        <div class="flex items-center gap-3">
          <ThemeToggle client:load />
          {user && <UserMenu user={user} client:load />}
        </div>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
